# Provedor: "openai" ou "google"
LLM_PROVIDER=

# Modelo: o desafio não fixa modelo. Escolha um que passe no teste de aptidão
# (python -m ferramentas.aptidao). Consulte a documentação oficial do provedor:
#   OpenAI -> https://platform.openai.com/docs/models
#   Google -> https://ai.google.dev/gemini-api/docs/models
# O ClienteLLM não envia temperatura: cada modelo usa o seu padrão.
# Modelos de raciocínio gastam tokens de saída que não aparecem na resposta,
# e esses tokens entram na conta do desafio.
LLM_MODEL=

OPENAI_API_KEY=
GOOGLE_API_KEY=

# Limite de requisições por minuto aplicado pelo próprio ClienteLLM.
# Vazio ou 0 = sem limite.
LLM_RPM=
