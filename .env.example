# Provedor: "openai" ou "google"
LLM_PROVIDER=

# Modelo: este desafio não fixa modelos, porque nomes e versões mudam com
# frequência. Consulte a documentação oficial do provedor escolhido:
#   OpenAI -> https://platform.openai.com/docs/models
#   Google -> https://ai.google.dev/gemini-api/docs/models
# O ClienteLLM usa temperature=0. Escolha um modelo que aceite esse valor:
# alguns modelos de raciocínio aceitam apenas o padrão e retornam erro 400.
# Use o MESMO modelo no baseline e em todas as execuções do seu pipeline.
LLM_MODEL=

OPENAI_API_KEY=
GOOGLE_API_KEY=

# Limite de requisições por minuto aplicado pelo próprio ClienteLLM.
# Deixe vazio (ou 0) para não limitar. Útil no plano gratuito do Gemini.
LLM_RPM=
